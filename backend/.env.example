# Optional approved product feed. Keep marketplace credentials in the feed
# service or backend environment; never compile them into the Flutter app.
FASHIONTECH_SHOP_CATALOG_URL=https://catalog.your-domain.example/fashiontech.json
FASHIONTECH_SHOP_CATALOG_TOKEN=replace-with-a-secret-bearer-token

